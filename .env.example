# Copy this file to .env.local (local) and add the same values in Vercel → Project → Settings → Environment Variables.
# Never commit real keys. Setup steps: docs/05-forms-setup.md

# --- Supabase: stores every enquiry in the `leads` table ---
# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# The secret "service_role" key (server only — never expose it in the browser)
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend: emails each new enquiry to your team + a thank-you to the visitor ---
# Resend → API Keys
RESEND_API_KEY=
# Must be on a domain you verified in Resend, e.g. "LTS Website <enquiries@yourdomain.com>"
LEADS_EMAIL_FROM=
# Who receives new-lead alerts (comma-separated for several people)
LEADS_EMAIL_TO=
# Set to false to stop the automatic thank-you email to visitors
LEADS_AUTO_REPLY=true

# --- Cloudflare Turnstile: invisible bot check on the forms (free) ---
# Cloudflare dashboard → Turnstile → Add site. Leave both empty to switch it off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics (loaded only after a visitor accepts cookies; banner appears only when one is set) ---
# Google Analytics 4 → Admin → Data streams → Measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=
# Microsoft Clarity → Settings → Project ID
NEXT_PUBLIC_CLARITY_ID=

# --- Online booking (optional) ---
# Paste your Calendly / Cal.com / Google Calendar booking link (must start with https://).
# The contact page's "Book a free call" button opens it. Leave empty to send visitors to /free-ai-audit instead.
NEXT_PUBLIC_BOOKING_URL=

# --- Admin dashboard (/admin): lists enquiries and subscribers from Supabase ---
# Choose a long password (8+ characters). Leave empty to keep /admin switched off.
ADMIN_PASSWORD=
# Optional: a separate random string used to sign the login cookie (defaults to the password)
ADMIN_SESSION_SECRET=
